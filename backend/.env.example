PORT=5000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_AUTO_DETECT_MODEL=nova-3-general
DEEPGRAM_FALLBACK_MODEL=whisper
DEEPGRAM_REQUEST_TIMEOUT_MS=600000
TRANSCRIPTION_SAMPLE_RATE=16000
TRANSCRIPT_LOW_CONFIDENCE_THRESHOLD=0.65
AUDIO_NORMALIZE=auto
AUDIO_DENOISE=false
SILENCE_MAX_VOLUME_DB=-55
PDF_FONT_PATH=

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_CORRECTION_MODEL=gpt-4o-mini

# MongoDB Atlas - format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.yljcryp.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=at2_transcriber

GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
# This redirect URI must match the authorized redirect URI configured in your Google OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
